{
  "name": "nexus-chat-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit && node --check src/nexus-engine.js",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:visual": "playwright test visual.spec.ts",
    "test:baseline": "playwright test visual.spec.ts --update-snapshots"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "marked": "^12.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.33",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
